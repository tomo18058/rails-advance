cat > .gitignore <<'EOF'
# Rails
/log/*
/tmp/*
/tmp/pids/*
/tmp/cache/*
/tmp/sockets/*
/storage/*

# Environment
.env
.env.*

# Bundler
/vendor/bundle

# OS/editor
.DS_Store
.vscode/

# Assets build (if you use js/css build tools)
# /public/assets
# /app/assets/builds
# Tailwind / asset builds
/app/assets/builds/*
!/app/assets/builds/.keep

EOF
