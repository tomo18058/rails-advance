<h1>管理ログイン</h1>

<% if flash[:alert].present? %>
  <p style="color:red"><%= flash[:alert] %></p>
<% end %>

<%= form_with url: admin_session_path, method: :post, scope: :session, local: true do |f| %>
  <div>
    <%= f.label :email, "メール" %><br>
    <%= f.email_field :email, autocomplete: "email", required: true %>
  </div>

  <div>
    <%= f.label :password, "パスワード" %><br>
    <%= f.password_field :password, autocomplete: "current-password", required: true %>
  </div>

  <%= f.submit "ログイン" %>
<% end %>
